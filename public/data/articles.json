      ],
      "author": "Terrence O’Brien",
      "publishedAt": "2026-05-26T16:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/main.jpg?quality=90&strip=all&crop=0,0.70054525196952,100,98.598909496061",
      "originalUrl": "https://www.theverge.com/entertainment/937054/arturia-memory-v-memorymoog-synthesizer",
      "readTimeMinutes": 2,
      "language": "en"
