      "author": "Andrew Webster",
      "publishedAt": "2026-07-24T17:40:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/07/Screenshot-2026-07-24-at-1.29.39-PM.png?quality=90&strip=all&crop=0%2C5.8264272693918%2C100%2C88.347145461216&w=1200",
