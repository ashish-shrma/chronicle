      "author": "Sean Hollister",
      "publishedAt": "2026-05-21T13:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/verge-mood-gemini-google-ai-studio.jpg?quality=90&strip=all&crop=0,15.095986038394,100,69.808027923211",
      "originalUrl": "https://www.theverge.com/ai-artificial-intelligence/935056/google-vibe-coding-first-android-app-gemini-ai-studio",
