      "author": null,
      "publishedAt": "2026-09-10T05:21:23.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/1221/live/8844d5d0-ac5b-11f1-be57-03729df1d736.jpg",
      "originalUrl": "https://www.bbc.co.uk/news/articles/clyl6ekpw2ko?at_medium=RSS&at_campaign=rss",
