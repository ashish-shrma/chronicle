      "author": "Charles Pulliam-Moore",
      "publishedAt": "2026-05-26T16:30:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/NORE_S1_UT_241022_EPSAAR_00447RC4_PC_-_Aaron_Epstein_-_Prime_Video_3000.jpg?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
