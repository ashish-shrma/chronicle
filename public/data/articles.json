      "publishedAt": "2026-11-18T09:29:32.000Z",
      "imageUrl": "https://energy-based-reasoners.github.io/static/images/ebr_landscape_abc_v1.png",
      "originalUrl": "https://energy-based-reasoners.github.io/",
