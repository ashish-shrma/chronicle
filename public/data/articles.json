      "publishedAt": "2026-07-31T18:13:09.000Z",
      "imageUrl": "https://media.newyorker.com/photos/6a6b679f0db75bb4e8447a67/16:9/w_2560,h_1440,c_limit/PrincessHidir_Toxic_Caterpillars_Final-1.png",
