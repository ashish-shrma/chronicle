      "author": "Andrew Liszewski",
      "publishedAt": "2026-09-09T22:23:35.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/duo6.jpg?quality=90&strip=all&crop=0,10.718648033352,100,78.562703933296",
