      "author": "Sheena Vasani",
      "publishedAt": "2026-05-30T15:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2025/04/samsungtheframetv75inch.jpg?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
