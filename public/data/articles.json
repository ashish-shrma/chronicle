      "author": null,
      "publishedAt": "2026-06-25T13:48:24.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/f5de/live/d782cda0-707e-11f1-a866-abbad6b6b076.jpg",
      "originalUrl": "https://www.bbc.co.uk/news/articles/cy5vq3q2g19o?at_medium=RSS&at_campaign=rss",
