      "author": "Terrence O’Brien",
      "publishedAt": "2026-09-05T15:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/andy.png?quality=90&strip=all&crop=0,23.821989528796,100,52.356020942408",
      "originalUrl": "https://www.theverge.com/report/989270/fantasy-footballers-podcast-andy-holloway-interview",
