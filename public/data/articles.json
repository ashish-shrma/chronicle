      "author": "Lauren Feiner",
      "publishedAt": "2026-07-30T17:08:14.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2025/03/STKP211_BRENDAN_CARR_A.jpg?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
      "originalUrl": "https://www.theverge.com/policy/973289/abc-fcc-early-license-renewal-opposition",
