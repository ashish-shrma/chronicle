      "author": "Terrence O’Brien",
      "publishedAt": "2026-11-14T17:44:28.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/11/gettyimages-2304493507.jpg?quality=90&strip=all&crop=0,10.654918655606,100,78.690162688789",
      "originalUrl": "https://www.theverge.com/transportation/1033898/faa-ground-stop-sean-duffy-faa-copper-wire",
