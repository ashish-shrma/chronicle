      "author": "Terrence O’Brien",
      "publishedAt": "2026-09-13T17:36:10.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/a1818657383_10.jpg?quality=90&strip=all&crop=0,23.821989528796,100,52.356020942408",
