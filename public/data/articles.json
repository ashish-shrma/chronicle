      "author": null,
      "publishedAt": "2026-08-27T20:52:31.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/72a1/live/efb60850-a225-11f1-bd6a-3d72a7f54a3e.jpg",
      "originalUrl": "https://www.bbc.co.uk/news/articles/c4gvx54ppn5o?at_medium=RSS&at_campaign=rss",
