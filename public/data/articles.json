      "author": "Tom Warren",
      "publishedAt": "2026-05-29T23:03:29.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/gettyimages-2192219004.jpg?quality=90&strip=all&crop=0,10.703832833872,100,78.592334332257",
