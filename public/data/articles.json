      "author": "sbulaev",
      "publishedAt": "2026-09-11T14:07:08.000Z",
      "imageUrl": "https://media.wired.com/photos/6aa34b1b31130b4af58e1d2b/16:9/w_2496,h_1404,c_limit/John-Deere-5ML-Tractor.jpg",
