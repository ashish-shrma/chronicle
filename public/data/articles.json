      "author": "Allison Johnson",
      "publishedAt": "2026-05-23T11:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/ai-label-19.png?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
