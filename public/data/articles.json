      "tags": [],
      "author": "Theresa Loconsolo",
      "publishedAt": "2026-05-20T21:21:22.000Z",
      "imageUrl": "https://techcrunch.com/wp-content/uploads/2026/05/Lucra-Sports-Dylan-Robbins.jpg?resize=1200,1082",
      "originalUrl": "https://techcrunch.com/video/you-dont-need-to-be-an-ai-startup-to-raise-lucra-has-20m-to-prove-it/",
