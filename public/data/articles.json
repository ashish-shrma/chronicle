      ],
      "author": "Sean Hollister",
      "publishedAt": "2026-09-14T17:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/268694_Steam_Frame_KMcClellan_0047.jpg?quality=90&strip=all&crop=0,15.095986038394,100,69.808027923211",
