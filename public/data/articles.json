      ],
      "author": "Sheena Vasani",
      "publishedAt": "2026-06-26T16:26:06.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/03/268386_iPad_Air_M4_AKrales_0020.jpg?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
      "originalUrl": "https://www.theverge.com/gadgets/957106/prime-day-ipad-deals-apple-price-hikes",
