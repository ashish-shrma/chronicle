      "author": "Allison Johnson",
      "publishedAt": "2026-06-23T17:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/03/google-pixel-10a-7.jpg?quality=90&strip=all&crop=0,10.741906587151,100,78.516186825698",
