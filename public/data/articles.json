      "category": "tech",
      "tags": [],
      "author": "Tim De Chant",
      "publishedAt": "2026-05-23T13:00:00.000Z",
      "imageUrl": "https://techcrunch.com/wp-content/uploads/2026/05/GettyImages-2275592313.jpg?resize=1200,800",
