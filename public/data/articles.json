      "author": null,
      "publishedAt": "2026-11-21T08:13:58.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_sport/1200/cpsprodpb/618b/live/83c124c0-e57a-11f1-a5f6-b3028adf2d6d.jpg",
      "originalUrl": "https://www.bbc.co.uk/sport/formula1/articles/c34gnrvl9zvro?at_medium=RSS&at_campaign=rss",
