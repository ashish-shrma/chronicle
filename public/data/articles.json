      "author": "Dominic Preston",
      "publishedAt": "2026-05-27T12:04:42.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/redmagic-11s-pro-1.jpg?quality=90&strip=all&crop=0,10.741906587151,100,78.516186825698",
