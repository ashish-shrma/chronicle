      "author": "nedwin",
      "publishedAt": "2026-06-02T12:01:04.000Z",
      "imageUrl": "https://bookface-images.s3.amazonaws.com/logos/876e548b9ee8e5740c35f5d6ddf2ce32d924edc7.png?1604424519",
