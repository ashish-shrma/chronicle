      "author": null,
      "publishedAt": "2026-09-10T05:21:13.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_sport/1200/cpsprodpb/6356/live/471fff50-ab87-11f1-83f1-8f6cbf03142e.png",
      "originalUrl": "https://www.bbc.co.uk/sport/formula1/articles/cjw5n195nx8o?at_medium=RSS&at_campaign=rss",
