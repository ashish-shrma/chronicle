      "author": null,
      "publishedAt": "2026-08-01T05:01:19.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/53b8/live/bedaaee0-8ce8-11f1-b2ab-0dd01740f9f6.png",
      "originalUrl": "https://www.bbc.co.uk/news/articles/c9w0ygrwrn5o?at_medium=RSS&at_campaign=rss",
