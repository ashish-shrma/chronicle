      ],
      "author": "cdrnsf",
      "publishedAt": "2026-05-21T12:58:18.000Z",
      "imageUrl": "https://media.wired.com/photos/6a0e0f8f6174d8e9dcf1157d/16:9/w_2400,h_1350,c_limit/security_flock_GettyImages-2271667850.jpg",
      "originalUrl": "https://www.wired.com/story/a-bipartisan-amendment-would-end-police-license-plate-tracking-nationwide/",
