      "author": "Jay Peters",
      "publishedAt": "2026-09-01T13:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/nba-2k-image.jpg?quality=90&strip=all&crop=0,10.724534322093,100,78.550931355815",
