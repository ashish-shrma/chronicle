      "author": "David Pierce",
      "publishedAt": "2026-09-21T13:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/268755_Google_event_Dell_XPS_Googlebook_ADiBenedetto_0002.jpg?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
      "originalUrl": "https://www.theverge.com/tech/997972/googlebook-laptop-chromeos-android-history",
