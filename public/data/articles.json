      ],
      "author": "Emma Roth",
      "publishedAt": "2026-07-24T19:06:58.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/07/STK414_AI_CHATBOT_E-1.jpg?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
