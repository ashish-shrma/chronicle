      "author": "Dominic Preston",
      "publishedAt": "2026-09-22T20:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/09/motorola-signature-27-green-hand.jpg?quality=90&strip=all&crop=0,10.740572122316,100,78.518855755368",
      "originalUrl": "https://www.theverge.com/tech/998844/motorola-signature-27-specs-snapdragon-8-elite-extreme-gen-6",
