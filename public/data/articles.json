      "author": "Andrew J. Hawkins",
      "publishedAt": "2026-06-12T13:54:49.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/06/STKE012_SPACEX_IPO_2026_F.jpg?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
      "originalUrl": "https://www.theverge.com/science/947926/spacex-ipo-stock-shares-trading-elon-musk",
      "readTimeMinutes": 3,
      "language": "en"
