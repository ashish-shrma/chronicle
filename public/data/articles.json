      "author": null,
      "publishedAt": "2026-07-12T17:34:33.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_sport/1200/cpsprodpb/61b0/live/bb6bc580-7e03-11f1-b976-0b9c15b0ccfc.png",
      "originalUrl": "https://www.bbc.co.uk/sport/cricket/articles/c0ly317wg32o?at_medium=RSS&at_campaign=rss",
      "readTimeMinutes": 6,
      "language": "en"
