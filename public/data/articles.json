      "author": "Mia Sato",
      "publishedAt": "2026-05-25T15:05:07.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/gettyimages-2278126608.jpg?quality=90&strip=all&crop=0,0,100,78.487862082976",
