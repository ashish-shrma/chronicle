      "tags": [],
      "author": null,
      "publishedAt": "2026-06-30T07:31:23.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/23aa/live/51d21b10-746c-11f1-85a5-7b95e37d4c35.jpg",
      "originalUrl": "https://www.bbc.co.uk/news/articles/c20yz4e7wlqo?at_medium=RSS&at_campaign=rss",
