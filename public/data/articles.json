      "author": "Stevie Bonifield",
      "publishedAt": "2026-07-10T00:04:13.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/04/STKS528_DATA_CENTERS_A.jpg?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
