      "author": null,
      "publishedAt": "2026-11-24T16:30:19.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/be90/live/aad9c570-e729-11f1-914b-6d226d813a52.jpg",
      "originalUrl": "https://www.bbc.co.uk/news/articles/cm930y07p0j2o?at_medium=RSS&at_campaign=rss",
