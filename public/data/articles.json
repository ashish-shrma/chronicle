      "author": null,
      "publishedAt": "2026-11-19T09:26:59.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/5545/live/187c4b30-e40e-11f1-99a1-253766e7ad8b.jpg",
      "originalUrl": "https://www.bbc.co.uk/news/articles/cw987ynpd0n1o?at_medium=RSS&at_campaign=rss",
