      "category": "tech",
      "tags": [],
      "author": "aviaviavi",
      "publishedAt": "2026-07-10T13:30:41.000Z",
      "imageUrl": "https://avi.press/images/og/2026-07-10-after-7-years-in-production-scarf-has-reluctantly-moved-away-from-haskell.png",
      "originalUrl": "https://avi.press/posts/2026-07-10-after-7-years-in-production-scarf-has-reluctantly-moved-away-from-haskell.html",
