        "Prime Day",
        "Verge Shopping"
      ],
      "author": "John.Higgins",
      "publishedAt": "2026-06-23T18:30:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/23454336/DSCF7813.jpg?quality=90&strip=all&crop=0,10.732984293194,100,78.534031413613",
