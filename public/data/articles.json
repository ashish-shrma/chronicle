        "Cambridge Analytica"
      ],
      "author": "pseudolus",
      "publishedAt": "2026-09-26T01:36:50.000Z",
      "imageUrl": "https://assets3.cbsnewsstatic.com/hub/i/r/2026/07/15/75086901-0979-4c15-bff8-e08d099a0d48/thumbnail/1200x630/dd6c3a2164e3ba2fd68f4b4a7fde49d9/gettyimages-2272777092.jpg",
