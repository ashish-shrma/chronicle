        "News",
        "Tech"
      ],
      "author": "Stevie Bonifield",
      "publishedAt": "2026-07-21T17:12:06.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2025/09/257981_Techwoven_AJohnson_0002.jpg?quality=90&strip=all&crop=0,10.723165084465,100,78.55366983107",
