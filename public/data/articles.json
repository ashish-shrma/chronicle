    {
      "id": "bbc-2026-09-18-former-shoplifter-ran-steal-to-order-whatsapp-group",
      "title": "Former shoplifter ran 'steal-to-order' Whatsapp group",
      "summary": "Keeley Knowles ran a Whatsapp group with about 200 people asking her to steal specific designer items.",
