      "tags": [],
      "author": null,
      "publishedAt": "2026-06-02T16:15:09.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_sport/1200/cpsprodpb/2043/live/3a226dc0-5e9c-11f1-be30-5d712cf191bd.jpg",
      "originalUrl": "https://www.bbc.com/sport/football/articles/cx218elj1v0o?at_medium=RSS&at_campaign=rss",
