      "author": null,
      "publishedAt": "2026-06-02T16:04:18.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/news/1024/branded_news/aede/live/aad19c60-28ed-11f1-a95f-75471ca6e71e.jpg",
