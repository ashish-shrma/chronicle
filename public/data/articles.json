      "author": "David Imel",
      "publishedAt": "2026-07-13T20:43:20.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/07/Siri-AI-Being-invoked-3.jpg?quality=90&strip=all&crop=0,10.727837220746,100,78.544325558509",
