      "author": "allidoisvim",
      "publishedAt": "2026-11-20T20:07:14.000Z",
      "imageUrl": "https://master--ytulsiani.netlify.app/blog/furrytails/maisie-header.png",
      "originalUrl": "https://master--ytulsiani.netlify.app/blog/furrytails/",
