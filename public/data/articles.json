      "author": "j4mie",
      "publishedAt": "2026-07-13T06:02:11.000Z",
      "imageUrl": "https://i.guim.co.uk/img/media/7f0c84a75f72a1f66a9f0ba791015de34e57334d/0_1050_3648_2189/master/3648.jpg?width=1200&height=630&quality=85&auto=format&fit=crop&precrop=40:21,offset-x50,offset-y0&overlay-align=bottom%2Cleft&overlay-width=100p&overlay-base64=L2ltZy9zdGF0aWMvb3ZlcmxheXMvdGctZGVmYXVsdC5wbmc&enable=upscale&s=66f9c753cd98468c4d0e88b6cc704ba2",
