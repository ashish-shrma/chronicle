      "author": null,
      "publishedAt": "2026-09-10T22:48:37.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/4aa2/live/7b5bb340-ad67-11f1-a540-61c3f7fc4e6c.jpg",
