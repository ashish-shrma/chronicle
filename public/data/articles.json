      "category": "tech",
      "tags": [],
      "author": "uneven9434",
      "publishedAt": "2026-08-30T09:52:15.000Z",
      "imageUrl": null,
      "originalUrl": "https://blog.lyc8503.net/en/post/dn42-2-dnet/",
      "readTimeMinutes": 3,
      "language": "en"
