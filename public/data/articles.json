      ],
      "author": "Andrew J. Hawkins",
      "publishedAt": "2026-05-21T03:42:45.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/04/gettyimages-2270729873.jpg?quality=90&strip=all&crop=0,10.750005106244,100,78.499989787512",
