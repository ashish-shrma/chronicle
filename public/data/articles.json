      "author": "Andrew J. Hawkins",
      "publishedAt": "2026-05-24T11:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/Photo-4.webp?quality=90&strip=all&crop=0,1.1248438379157,100,97.750312324169",
      "originalUrl": "https://www.theverge.com/transportation/936126/nuro-robotaxi-dave-ferguson-interview-uber-lucid-waymo",
