      "author": "handfuloflight",
      "publishedAt": "2026-07-19T01:33:32.000Z",
      "imageUrl": "https://opengraph.githubassets.com/9351583e2bb587fd33ee361551c30940a86f62abee13592c7d32e8280ef5d3f0/vercel-labs/deepsec",
