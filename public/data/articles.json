      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/Screenshot-2026-05-23-at-6.30.34PM.png?quality=90&strip=all&crop=0,9.6034762271773,100,80.793047545645",
      "originalUrl": "https://www.theverge.com/entertainment/936829/record-club-letterboxd-for-music-nerds",
      "readTimeMinutes": 1,
      "language": "en"
