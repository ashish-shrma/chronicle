      "author": null,
      "publishedAt": "2026-09-08T19:07:02.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_sport/1200/cpsprodpb/6342/live/4c500960-abb5-11f1-bb85-fd7540ffe1df.jpg",
      "originalUrl": "https://www.bbc.co.uk/sport/tennis/articles/c3v43p9r2qdo?at_medium=RSS&at_campaign=rss",
