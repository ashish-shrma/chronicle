      "author": "David Imel",
      "publishedAt": "2026-07-22T13:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/07/samsung-galaxy-z-fold-8-ultra-05.jpg?quality=90&strip=all&crop=0,10.741906587151,100,78.516186825698",
