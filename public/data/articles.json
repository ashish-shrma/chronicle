      "author": "Sheena Vasani",
      "publishedAt": "2026-07-06T20:24:28.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2025/10/hoto1.jpg?quality=90&strip=all&crop=0,10.677911339888,100,78.644177320224",
