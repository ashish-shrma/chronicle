      "author": null,
      "publishedAt": "2026-11-22T11:50:20.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/90be/live/2130a000-e66b-11f1-afe6-8bda8be22a92.jpg",
