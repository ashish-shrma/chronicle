      "author": null,
      "publishedAt": "2026-07-06T14:01:19.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/9d22/live/64107b80-7937-11f1-a8cf-13bdb1aa2cdd.jpg",
      "originalUrl": "https://www.bbc.co.uk/news/articles/c04yyx15xngo?at_medium=RSS&at_campaign=rss",
