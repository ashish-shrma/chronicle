      "category": "tech",
      "tags": [],
      "author": "SamuraiLion",
      "publishedAt": "2026-09-21T16:14:16.000Z",
      "imageUrl": "https://spectrum.ieee.org/media-library/image.png?id=67783301&width=1200&height=600&coordinates=0%2C167%2C0%2C168",
