      ],
      "author": "Emma Roth",
      "publishedAt": "2026-07-16T16:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/07/gemininotebook.png?quality=90&strip=all&crop=0,3.479841264548,100,93.040317470904",
