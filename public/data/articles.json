      "author": null,
      "publishedAt": "2026-08-21T17:46:04.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/8507/live/fdfd8b70-9d81-11f1-b109-879e35c24276.jpg",
      "originalUrl": "https://www.bbc.co.uk/news/articles/c0rdk9ddepvo?at_medium=RSS&at_campaign=rss",
