      "category": "tech",
      "tags": [],
      "author": "Ivan Mehta",
      "publishedAt": "2026-07-16T17:00:00.000Z",
      "imageUrl": "https://techcrunch.com/wp-content/uploads/2026/07/STILL_2_A.jpeg?resize=1200,675",
      "originalUrl": "https://techcrunch.com/2026/07/16/newsletter-platform-beehiiv-now-lets-subscribers-chat-with-each-other-adds-ai/",
      "readTimeMinutes": 1,
