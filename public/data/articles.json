      "author": null,
      "publishedAt": "2026-07-14T07:03:28.000Z",
      "imageUrl": "https://ichef.bbci.co.uk/ace/branded_news/1200/cpsprodpb/ce42/live/569754c0-7eb3-11f1-b5ec-67e9897fe2ad.jpg",
      "originalUrl": "https://www.bbc.co.uk/news/articles/cr7xgx831exo?at_medium=RSS&at_campaign=rss",
      "readTimeMinutes": 3,
