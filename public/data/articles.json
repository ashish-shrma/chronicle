      "author": "Charles Pulliam-Moore",
      "publishedAt": "2026-05-29T13:00:00.000Z",
      "imageUrl": "https://platform.theverge.com/wp-content/uploads/sites/2/2026/05/H4A8380.jpg?quality=90&strip=all&crop=0,10.805990696898,100,78.388018606203",
      "originalUrl": "https://www.theverge.com/entertainment/938437/backrooms-youtube-kane-parsons-a12",
