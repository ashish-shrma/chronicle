# Adobe Launch (reusing the Moksha property). at_property and ECID are configured
# inside the Launch bundle itself, so you don't need NEXT_PUBLIC_TARGET_PROPERTY for
# Target to work — leave it blank unless you want page-level overrides.
NEXT_PUBLIC_LAUNCH_URL=https://assets.adobedtm.com/6a203c8a0ff8/4d3b14477614/launch-496fd487c23d-development.min.js
NEXT_PUBLIC_TARGET_PROPERTY=

# Only needed for Reader Picker → Customer Attributes demo. Leave blank to skip.
NEXT_PUBLIC_ECID_ORG_ID=

# Optional content sources — pipeline runs RSS-only if these are blank.
NEWSAPI_KEY=
GUARDIAN_API_KEY=

# Optional — weather widget integration (not yet wired up).
OPENWEATHER_API_KEY=
